{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "revised-finanx",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-27",
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "revised-finanx-db",
      "database_id": "097120d9-dd9f-4ba8-b4ad-a71dd5221ded"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "ANALYSIS_QUEUE", "queue": "revised-finanx-analysis" },
      { "binding": "FULLINDEX_QUEUE", "queue": "revised-finanx-fullindex" }
    ],
    "consumers": [
      {
        "queue": "revised-finanx-fullindex",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 30,
        "dead_letter_queue": "revised-finanx-analysis-dlq"
      },
      {
        "queue": "revised-finanx-analysis",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 30,
        "dead_letter_queue": "revised-finanx-analysis-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["*/2 * * * *", "1-59/2 * * * *"]
  }
}
